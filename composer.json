{
    "authors": [
        {
            "email": "andykanidimbu@gmail.com",
            "name": "Andy Kani"
        }
    ],
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Roster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "description": "Clean and flexible scheduling for Laravel applications.",
    "extra": {
        "laravel": {
            "aliases": {
                "Roster": "Roster\\Facades\\Roster"
            },
            "providers": [
                "Roster\\RosterServiceProvider"
            ]
        }
    },
    "keywords": [
        "laravel",
        "laravel-package",
        "scheduler",
        "scheduling",
        "availability",
        "bookings",
        "appointments",
        "time-slots",
        "shifts",
        "roster",
        "calendar",
        "Eloquent",
        "traits",
        "PHP",
        "open-source"
    ],
    "license": "MIT",
    "minimum-stability": "dev",
    "name": "andydefer/laravel-roster",
    "prefer-stable": true,
    "require": {
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0",
        "laravel/framework": "^12.0",
        "php": "^8.2"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.8",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.2",
        "symfony/var-dumper": "^7.0",
        "vimeo/psalm": "^6.14"
    },
    "scripts": {
        "post-autoload-dump": [
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "type": "library"
}