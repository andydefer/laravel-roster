{
    "authors": [
        {
            "email": "andykanidimbu@gmail.com",
            "name": "Andy Kani"
        }
    ],
    "autoload": {
        "psr-4": {
            "Roster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Roster\\Tests\\": "tests/"
        }
    },
    "description": "Clean and flexible scheduling for Laravel applications.",
    "extra": {
        "laravel": {
            "aliases": {
                "Roster": "Roster\\Facades\\Roster"
            },
            "providers": [
                "Roster\\RosterServiceProvider"
            ]
        }
    },
    "keywords": [
        "laravel",
        "laravel-package",
        "scheduler",
        "scheduling",
        "availability",
        "bookings",
        "appointments",
        "time-slots",
        "shifts",
        "roster",
        "calendar",
        "Eloquent",
        "traits",
        "PHP",
        "open-source"
    ],
    "license": "MIT",
    "minimum-stability": "dev",
    "name": "andydefer/roster",
    "prefer-stable": true,
    "require": {
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0",
        "laravel/framework": "^12.0",
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/var-dumper": "^7.0"
    },
    "type": "library"
}