# phpstan.neon
parameters:
    # Niveau de rigueur : 8 = très strict
    level: max
    paths:
        - app
        - config
        - routes
        - database
        - tests

    # Ignorer certains fichiers si nécessaire
    excludePaths:
        - */vendor/*
        - */storage/*
        - */bootstrap/cache/*

    # Nombre de threads pour l'analyse
    parallel:
        maximumProcessCount: 8

    # Vérifie les types de retour, arguments et propriétés
    checkMissingIterableValueType: true
    checkMissingVarTagType: true
    checkGenericClassInNonGenericObjectType: true
    checkGenericClassInNonGenericStaticMethod: true
    checkGenericClassInNonGenericMethodCall: true
    checkExtraArguments: true
    checkNullables: true
    checkUnionTypes: true

    # Analyse des propriétés statiques et dynamiques
    checkThisOnly: false
    inferPrivatePropertyTypeFromConstructor: true

    # Laravel spécifique : reconnait les helpers

# Extensions Larastan pour Laravel
services:
    -
        class: PHPStan\Rules\Methods\CallMethodsRule
        tags: [phpstan.rules.rule]

